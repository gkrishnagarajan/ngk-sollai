"""
exhibit_norm.py — Normalise exhibit references in Tamil court judgments.

அரசுத்தரப்பு சான்றாவணம் ஏன் 2         →  அ.சா.ஆ. 2
அரசுத்தரப்பு சான்றாபனம் என் ஐந்தாகவும் →  அ.சா.ஆ. 5 ஆகவும்
எதிர்த்தரப்பு சான்றாவணம் எண். 3        →  எ.சா.ஆ. 3
"""
import re

# ------------------------------------------------------------------ #
#  Tamil number words 1-50                                             #
# ------------------------------------------------------------------ #
_TAMIL_NUMS = {
    1:"ஒன்று", 2:"இரண்டு", 3:"மூன்று", 4:"நான்கு", 5:"ஐந்து",
    6:"ஆறு", 7:"ஏழு", 8:"எட்டு", 9:"ஒன்பது", 10:"பத்து",
    11:"பதினொன்று", 12:"பனிரண்டு", 13:"பதிமூன்று", 14:"பதினான்கு",
    15:"பதினைந்து", 16:"பதினாறு", 17:"பதினேழு", 18:"பதினெட்டு",
    19:"பத்தொன்பது", 20:"இருபது",
    21:"இருபத்தொன்று", 22:"இருபத்திரண்டு", 23:"இருபத்துமூன்று",
    24:"இருபத்துநான்கு", 25:"இருபத்தைந்து", 26:"இருபத்தாறு",
    27:"இருபத்தேழு", 28:"இருபத்தெட்டு", 29:"இருபத்தொன்பது",
    30:"முப்பது", 31:"முப்பத்தொன்று", 32:"முப்பத்திரண்டு",
    33:"முப்பத்துமூன்று", 34:"முப்பத்துநான்கு", 35:"முப்பத்தைந்து",
    36:"முப்பத்தாறு", 37:"முப்பத்தேழு", 38:"முப்பத்தெட்டு",
    39:"முப்பத்தொன்பது", 40:"நாற்பது",
    41:"நாற்பத்தொன்று", 42:"நாற்பத்திரண்டு", 43:"நாற்பத்துமூன்று",
    44:"நாற்பத்துநான்கு", 45:"நாற்பத்தைந்து", 46:"நாற்பத்தாறு",
    47:"நாற்பத்தேழு", 48:"நாற்பத்தெட்டு", 49:"நாற்பத்தொன்பது",
    50:"ஐம்பது",
}
_WORD_TO_DIGIT = {v: str(k) for k, v in _TAMIL_NUMS.items()}
# Voice-typing mishears of number words
_WORD_TO_DIGIT.update({
    'உண்பது': '9',   # உண்பது (ஒன் → உண் mishear of ஒன்பது)
    'ஒண்பது': '9',   # ஒண்பது (colloquial)
    'உண்பது': '9',   # duplicate guard
    'ரெண்டு': '2',   # ரெண்டு (colloquial இரண்டு)
    'நாலு': '4',      # நாலு (colloquial நான்கு)
    'அஞ்சு': '5',      # அஞ்சு (colloquial ஐந்து)
    'மூணு': '3',      # மூணு (colloquial மூன்று)
    'ஏழு': '7',      # ஏழு (same as ஏழு - confirm)
    'ஒன்ரு': '1',   # ஒன்ரு (voice mishear of ஒன்று)
})
_NUMWORD_LIST  = sorted(_TAMIL_NUMS.values(), key=len, reverse=True)

# Suffixes that follow number words in judicial text — preserved in output
_NUM_SUFFIXES = (
    'ஆகவும்', 'ஆகவோ', 'ஆவதும்', 'ஆவது', 'ஆகும்', 'ஆக',
    'ஆம்', 'இல்', 'இன்', 'ஐ', 'உடன்',
)

# Build extended list: bare word + word+suffix combinations
_NUMWORD_EXT = []
for w in _NUMWORD_LIST:
    for sfx in _NUM_SUFFIXES:
        _NUMWORD_EXT.append(w + sfx)  # suffixed first (longer match priority)
    _NUMWORD_EXT.append(w)
# Apply Tamil sandhi: final உ/ு + ஆ → ஆ (e.g. ஐந்து+ஆகவும் → ஐந்தாகவும்)
def _sandhi(word, sfx):
    if sfx.startswith('ஆ'):
        for ending, replacement in [
            ('பது', 'பதா'),
            ('று', 'றா'),
            ('து', 'தா'),
            ('டு', 'டா'),
            ('ழு', 'ழா'),
            ('னு', 'னா'),
            ('ணு', 'ணா'),
           ('கு', 'கா'),  # நான்கு+ஆக → நான்காக
           ('ரு', 'ரா'),  # ஆறு+ஆக → ஆறாக
            ('லு', 'லா'),  # நாலு+ஆக → நாலாக
            ('சு', 'சா'),  # அஞ்சு+ஆக → அஞ்சாக
            ('மு', 'மா'),  # மூணு+ஆக edge case
        ]:
            if word.endswith(ending):
                return word[:-len(ending)] + replacement + sfx[1:]
    return word + sfx

for w in _NUMWORD_LIST:
    for sfx in _NUM_SUFFIXES:
        sandhi_form = _sandhi(w, sfx)
        if sandhi_form != w + sfx:
            _NUMWORD_EXT.append(sandhi_form)

_NUMWORD_EXT = sorted(set(_NUMWORD_EXT), key=len, reverse=True)
# Add mishear numwords to _NUMWORD_EXT and apply sandhi
_mishear_words = [
    'உண்பது',
    'ஒண்பது',
    'ரெண்டு',
    'நாலு',
    'அஞ்சு',
    'மூணு',
]
for _mw in _mishear_words:
    for _sfx in _NUM_SUFFIXES:
        _NUMWORD_EXT.append(_mw + _sfx)
        _sf = _sandhi(_mw, _sfx)
        if _sf != _mw + _sfx:
            _NUMWORD_EXT.append(_sf)
    _NUMWORD_EXT.append(_mw)
_NUMWORD_EXT = sorted(set(_NUMWORD_EXT), key=len, reverse=True)

# ------------------------------------------------------------------ #
#  Voice-typing variant patterns                                        #
# ------------------------------------------------------------------ #
_PROSECUTION = (
    r'அரசுத்\s*தரப்பு'
    r'|அரசு\s*த்\s*தரப்பு'
    r'|அரசு\s*தரப்பு'
    r'|அரசுத்தரப்பின்'
    r'|அரசு\s*தரப்பின்'
    r'|அரசத்\s*தரப்பு'
    r'|அரசத்தரப்பு'
    r'|அரசத்தரப்பின்'
    r'|அரசு\s*தரப்\s*பு'
)

_DEFENCE = (
    r'எதிர்த்\s*தரப்பு'
    r'|எதிர்\s*த்\s*தரப்பு'
    r'|எதிர்\s*தரப்பு'
    r'|எதிர்த்தரப்பின்'
    r'|எதிர்\s*தரப்பின்'
    r'|எதிர்\s*தரப்'
)

_SAANRU = (
    r'சான்றாவணம்'
    r'|சான்றாவனம்'
    r'|சான்று\s*ஆவணம்'
    r'|சான்று\s*ஆவனம்'
    r'|சான்றாவணங்கள்'
    r'|சான்றாவனங்கள்'
    r'|சான்றா\s*வணம்'
    r'|சான்றா\s*வனம்'
    r'|சான்\s*றாவணம்'
    r'|சான்\s*றாவனம்'
    r'|சாண்றாவணம்'
    r'|சாண்றாவனம்'
    r'|சான்றோவணம்'
    r'|சான்றோவனம்'
    r'|சான்றாபணம்'
    r'|சான்றாபனம்'
    r'|சான்றாபணங்கள்'
    r'|சான்றாபனங்கள்'
    r'|சான்றாவனும்'          # ம் → ம்+உ voice-type
    r'|சான்றாவணும்'
    r'|சான்றாவினும்'
    r'|சான்றாவனுமா'
   r'|சான்றாகணும்'  # சான்றாகணும்
   r'|சான்றாகணம்'         # சான்றாகணம்
   r'|சான்றா கணும்'  # split
   r'|சான்றா\s*குணம்'   # குணம் = Whisper hallucination of ஆவணம்
   r'|சான்ரா\s*குணம்'   # ற→ர mishear + குணம் hallucination
   r'|சான்றாகுணம்'      # fused form
)

_ENUM = (
    r'(?:\s*(?:'
    r'எண்\.?|ஏன்\.?|இன்|ஆன்|ஆம்|என்|யின்|எண்'
    r')\s*|\s+)'
)

# Group 1 = digit (with optional letter) OR Tamil number word (with/without suffix)
# Rebuild _NUM with mishear words included
_NUM = r'(\d+[A-Za-z]?|' + '|'.join(_NUMWORD_EXT) + r')'

# ------------------------------------------------------------------ #
#  Compiled patterns                                                    #
# ------------------------------------------------------------------ #
_PAT_PROS = re.compile(
    r'(?:' + _PROSECUTION + r')\s*(?:' + _SAANRU + r')' + _ENUM + _NUM,
    re.UNICODE
)
_PAT_DEF = re.compile(
    r'(?:' + _DEFENCE + r')\s*(?:' + _SAANRU + r')' + _ENUM + _NUM,
    re.UNICODE
)

# ------------------------------------------------------------------ #
#  Helpers                                                              #
# ------------------------------------------------------------------ #
def _parse_numword(s):
    """Split captured string into (digit, suffix).
    e.g. 'ஐந்தாகவும்' → ('5', ' ஆகவும்')
         '5'           → ('5', '')
         'ஐந்து'       → ('5', '')
    """
    s = s.strip()
    # Already a digit
    if re.match(r'^\d+[A-Za-z]?$', s):
        return s, ''
    # Try word+suffix
    for sfx in _NUM_SUFFIXES:
        if s.endswith(sfx):
            base = s[:-len(sfx)]
            if base in _WORD_TO_DIGIT:
                return _WORD_TO_DIGIT[base], ' ' + sfx
    # Bare word
    if s in _WORD_TO_DIGIT:
        return _WORD_TO_DIGIT[s], ''
    # Reverse sandhi lookup — try all words and suffixes
    for w, d in _WORD_TO_DIGIT.items():
        for sfx in _NUM_SUFFIXES:
            if _sandhi(w, sfx) == s:
                return d, ' ' + sfx
    return s, ''

def fix_exhibit_spacing(text):
    """அ.சா.ஆ.3 → அ.சா.ஆ. 3"""
    text = re.sub(r'([அெ]\.சா\.ஆ\.)(\d)', r'\1 \2', text)
    return text

# ------------------------------------------------------------------ #
#  Main normaliser                                                      #
# ------------------------------------------------------------------ #
def normalise_exhibits(text):
    """Replace long-form exhibit references with standard abbreviations.
    Preserves case suffixes like ஆகவும் after the number.
    Returns (corrected_text, changes_list).
    """
    changes = []
    out = text

    def _repl_pros(m):
        num, sfx = _parse_numword(m.group(1))
        new = 'அ.சா.ஆ. ' + num + sfx
        changes.append({'wrong': m.group(0), 'correct': new,
                        'category': 'exhibit_norm', 'source': 'exhibit_norm'})
        return new

    def _repl_def(m):
        num, sfx = _parse_numword(m.group(1))
        new = 'எ.சா.ஆ. ' + num + sfx
        changes.append({'wrong': m.group(0), 'correct': new,
                        'category': 'exhibit_norm', 'source': 'exhibit_norm'})
        return new

    out = _PAT_PROS.sub(_repl_pros, out)
    out = _PAT_DEF.sub(_repl_def, out)
    out = fix_exhibit_spacing(out)
    return out, changes


if __name__ == '__main__':
    tests = [
