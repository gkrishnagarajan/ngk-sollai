        ('அரசு தரப்பு சான்றாவனம் எண் 10',             'அ.சா.ஆ. 10'),
        ('அரசுத்தரப்பின் சான்றாவணம் 3',                'அ.சா.ஆ. 3'),
        ('அரசுத்தரப்பு சான்றாவணம் ஏன் 12A',           'அ.சா.ஆ. 12A'),
        ('அரசுத்தரப்பு சான்றாவனம் இன் ஒன்று',         'அ.சா.ஆ. 1'),
        ('அரசு தரப்பு சான்றாவனம் இன் இரண்டு',        'அ.சா.ஆ. 2'),
        ('அரசுத்தரப்பு சான்றாவணம் ஆம் மூன்று',       'அ.சா.ஆ. 3'),
        ('அரசுத்தரப்பு சான்றாவணம் என் பத்து',        'அ.சா.ஆ. 10'),
        ('அரசுத்தரப்பு சான்றாபனம் என் ஐந்தாகவும்',   'அ.சா.ஆ. 5 ஆகவும்'),
        ('அரசுத்தரப்பு சான்றாபனம் என் ஆறாகவும்',     'அ.சா.ஆ. 6 ஆகவும்'),
        ('எதிர்த்தரப்பு சான்றாவணம் எண். 1',           'எ.சா.ஆ. 1'),
        ('எதிர் தரப்பு சான்றாவனம் இன் மூன்று',       'எ.சா.ஆ. 3'),
        ('எதிர்த்தரப்பின் சான்றாவணம் 7',              'எ.சா.ஆ. 7'),
        ('அ.சா.ஆ.5 ஆக குறியீடு',                     'அ.சா.ஆ. 5 ஆக குறியீடு'),
        ('சாதாரண வாக்கியம்',                           'சாதாரண வாக்கியம்'),
    ]
    passed = 0
    for t, expected in tests:
        out, ch = normalise_exhibits(t)
        ok = out.strip() == expected.strip()
        print('✓' if ok else '✗', repr(t[:45]))
        if not ok:
            print('  expected:', expected)
            print('  got:     ', out)
        passed += ok
    print(f'\n{passed}/{len(tests)} passed')
